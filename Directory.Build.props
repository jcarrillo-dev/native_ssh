<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Sin IDE, el .editorconfig solo se cumple si el estilo se comprueba al compilar -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Necesario para que IDE0005 (usings sobrantes) se compruebe al compilar. Es un ejecutable, no un paquete: sin XML obligatorio -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Escáner de seguridad NuGet activado en modo estricto -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Sistema para el que se compila lo que depende del sistema (*.Linux.cs, *.Windows.cs, *.Unix.cs: la resolución de
       NATIVE_SSH_SOLO_LECTURA por familia): por el RID si lo hay (win-* windows, linux-* linux, los demás unix: osx, freebsd...)
       y si no, el del sistema donde se compila. Solo entra en el binario lo de su sistema. Se puede fijar con
       -p:NativeSshSistema=windows|linux|unix (p. ej. para compilar y probar en Linux lo de Windows). Define NATIVE_SSH_WINDOWS,
       NATIVE_SSH_LINUX o NATIVE_SSH_UNIX para las pruebas propias de cada sistema. Una variable de entorno NativeSshSistema
       (con cualquier combinación de mayúsculas: MSBuild convierte las variables de entorno en propiedades sin distinguirlas)
       no lo fija: solo vale una propiedad global (-p:NativeSshSistema), que no se puede pisar; para saber si lo es, se le da
       un valor de prueba: si lo toma, no era global y se descarta. -->
  <PropertyGroup>
    <NativeSshSistema>_sin_fijar_</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '_sin_fijar_'"></NativeSshSistema>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NativeSshSistema)' == ''">
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))">windows</NativeSshSistema>
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and '$(NativeSshSistema)' == '' and $(RuntimeIdentifier.StartsWith('linux-'))">linux</NativeSshSistema>
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and '$(NativeSshSistema)' == ''">unix</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == ''">unix</NativeSshSistema>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'windows'">$(DefineConstants);NATIVE_SSH_WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'linux'">$(DefineConstants);NATIVE_SSH_LINUX</DefineConstants>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'unix'">$(DefineConstants);NATIVE_SSH_UNIX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Linq" />
  </ItemGroup>

  <Target Name="EliminarSystemLinqGlobal" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Linq" />
    </ItemGroup>
  </Target>

  <!-- Solo las pruebas pueden usar System.Linq: en el resto de proyectos (también en los que se añadan) el build falla si
       algún fuente a compilar (también los generados, como el de los global using) lo nombra en un using (normal, global,
       static o alias) o con el nombre completo. Se busca por texto, sin contar lo que va tras '//' en la línea: un
       'Enumerable.' suelto no hace falta buscarlo, porque sin uno de esos usings no compila (ni se confunde así con
       string.Concat o ValueLinqDelayExtensiones). Tarea en línea de MSBuild (sin paquetes ni órdenes del shell): igual en
       Linux y en Windows. El SSH.NET del submódulo tiene su propio Directory.Build.props y no pasa por aquí. -->
  <PropertyGroup>
    <NativeSshProhibirLinq Condition="'$(NativeSshProhibirLinq)' == '' and '$(MSBuildProjectName)' != 'native_ssh.Test'">true</NativeSshProhibirLinq>
  </PropertyGroup>

  <UsingTask TaskName="NativeSshBuscarSystemLinq" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Fuentes ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Regex patron = new Regex(@"\busing\s+(global::)?System\.Linq\b|\busing\s+static\s+(global::)?System\.Linq\.|\busing\s+\w+\s*=\s*(global::)?System\.Linq\b|(global::|[^\w.])System\.Linq\.", RegexOptions.CultureInvariant);
        foreach (ITaskItem fuente in Fuentes)
        {
            string ruta = fuente.GetMetadata("FullPath");
            if (!File.Exists(ruta))
                continue;
            int numero = 0;
            foreach (string linea in File.ReadLines(ruta))
            {
                numero++;
                int comentario = linea.IndexOf("//", StringComparison.Ordinal);
                string codigo = comentario >= 0 ? linea.Substring(0, comentario) : linea;
                Match coincidencia = patron.Match(" " + codigo);
                if (coincidencia.Success)
                    Log.LogError(null, "NSLINQ", null, ruta, numero, coincidencia.Index, 0, 0, "System.Linq solo se puede usar en las pruebas (native_ssh.Test): '{0}'.", linea.Trim());
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Incremental: si ningún fuente cambió desde la última comprobación correcta, no se vuelve a compilar la tarea en
       línea ni a leer los fuentes (la marca solo se escribe si no hubo error). -->
  <Target Name="NativeSshProhibirSystemLinq" BeforeTargets="CoreCompile" Condition="'$(NativeSshProhibirLinq)' == 'true'"
          Inputs="@(Compile);$(MSBuildThisFileFullPath)" Outputs="$(IntermediateOutputPath)nativessh.sinlinq">
    <NativeSshBuscarSystemLinq Fuentes="@(Compile)" />
    <Touch Files="$(IntermediateOutputPath)nativessh.sinlinq" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)nativessh.sinlinq" />
    </ItemGroup>
  </Target>

</Project>
