<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Sin IDE, el .editorconfig solo se cumple si el estilo se comprueba al compilar -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Necesario para que IDE0005 (usings sobrantes) se compruebe al compilar. Es un ejecutable, no un paquete: sin XML obligatorio -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Escáner de seguridad NuGet activado en modo estricto -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Sistema para el que se compila lo que depende del sistema (*.Linux.cs, *.Windows.cs, *.Unix.cs: la resolución de
       NATIVE_SSH_SOLO_LECTURA por familia): por el RID si lo hay (win-* windows, linux-* linux, los demás unix: osx, freebsd...)
       y si no, el del sistema donde se compila. Solo entra en el binario lo de su sistema. Se puede fijar con
       -p:NativeSshSistema=windows|linux|unix (p. ej. para compilar y probar en Linux lo de Windows). Define NATIVE_SSH_WINDOWS,
       NATIVE_SSH_LINUX o NATIVE_SSH_UNIX para las pruebas propias de cada sistema. -->
  <PropertyGroup Condition="'$(NativeSshSistema)' == ''">
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))">windows</NativeSshSistema>
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and '$(NativeSshSistema)' == '' and $(RuntimeIdentifier.StartsWith('linux-'))">linux</NativeSshSistema>
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and '$(NativeSshSistema)' == ''">unix</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == ''">unix</NativeSshSistema>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'windows'">$(DefineConstants);NATIVE_SSH_WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'linux'">$(DefineConstants);NATIVE_SSH_LINUX</DefineConstants>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'unix'">$(DefineConstants);NATIVE_SSH_UNIX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Linq" />
  </ItemGroup>

  <Target Name="EliminarSystemLinqGlobal" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Linq" />
    </ItemGroup>
  </Target>

</Project>
