<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Sin IDE, el .editorconfig solo se cumple si el estilo se comprueba al compilar -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Necesario para que IDE0005 (usings sobrantes) se compruebe al compilar. Es un ejecutable, no un paquete: sin XML obligatorio -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Escáner de seguridad NuGet activado en modo estricto -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Linq" />
  </ItemGroup>

  <Target Name="EliminarSystemLinqGlobal" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Linq" />
    </ItemGroup>
  </Target>

</Project>
