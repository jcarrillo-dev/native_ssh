<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Sin IDE, el .editorconfig solo se cumple si el estilo se comprueba al compilar -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Necesario para que IDE0005 (usings sobrantes) se compruebe al compilar. Es un ejecutable, no un paquete: sin XML obligatorio -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Escáner de seguridad NuGet activado en modo estricto -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Sistema para el que se compila lo que depende del sistema (*.Linux.cs, *.Windows.cs, *.Unix.cs: la resolución de
       NATIVE_SSH_SOLO_LECTURA por familia): por el RID si lo hay (win-* windows, linux-* linux, los demás unix: osx, freebsd...)
       y si no, el del sistema donde se compila. Solo entra en el binario lo de su sistema. Se puede fijar con
       -p:NativeSshSistema=windows|linux|unix (p. ej. para compilar y probar en Linux lo de Windows). Define NATIVE_SSH_WINDOWS,
       NATIVE_SSH_LINUX o NATIVE_SSH_UNIX para las pruebas propias de cada sistema. Una variable de entorno NativeSshSistema
       (con cualquier combinación de mayúsculas: MSBuild convierte las variables de entorno en propiedades sin distinguirlas)
       no lo fija: solo vale una propiedad global (-p:NativeSshSistema), que no se puede pisar; para saber si lo es, se le da
       un valor de prueba: si lo toma, no era global y se descarta. -->
  <PropertyGroup>
    <NativeSshSistema>_sin_fijar_</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '_sin_fijar_'"></NativeSshSistema>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NativeSshSistema)' == ''">
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))">windows</NativeSshSistema>
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and '$(NativeSshSistema)' == '' and $(RuntimeIdentifier.StartsWith('linux-'))">linux</NativeSshSistema>
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and '$(NativeSshSistema)' == ''">unix</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == ''">unix</NativeSshSistema>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'windows'">$(DefineConstants);NATIVE_SSH_WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'linux'">$(DefineConstants);NATIVE_SSH_LINUX</DefineConstants>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'unix'">$(DefineConstants);NATIVE_SSH_UNIX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Linq" />
  </ItemGroup>

  <Target Name="EliminarSystemLinqGlobal" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Linq" />
    </ItemGroup>
  </Target>

  <!-- Solo las pruebas pueden usar System.Linq (exentos, más abajo). La comprobación definitiva mira el ensamblado compilado
       (msbuild/ComprobarSystemLinqEnIL.cs, tarea de MSBuild con System.Reflection.Metadata, sin paquetes ni órdenes del shell:
       igual en Linux y en Windows). El SSH.NET del submódulo tiene su propio Directory.Build.props y no pasa por aquí.
       La tarea se compila una vez en un ensamblado (target NativeSshCompilarTareaLinq, con el Csc del SDK) bajo obj/nslinq/
       de cada proyecto que la usa, y se reutiliza mientras no cambien el fuente ni MSBuild: su nombre lleva la fecha del
       fuente y la versión de MSBuild, así que un cambio compila otro (el viejo puede seguir cargado y bloqueado por un nodo de
       MSBuild en Windows) y nunca se usa uno desfasado. Va en el obj de cada proyecto para que dos proyectos en paralelo no
       escriban el mismo fichero. La ruta solo usa propiedades reservadas: ni un -p: ni un .csproj la cambian. Si el ensamblado
       no existe o no carga, el build falla (MSB4062). Las referencias son las de RoslynCodeTaskFactory (el netstandard.dll y
       las de MSBuild de su carpeta ref) y las builds para .NET Framework de System.Reflection.Metadata y
       System.Collections.Immutable que trae el SDK: las del paquete de referencia de net10.0 no casan con netstandard; si
       faltan, la tarea no compila y el build falla. -->
  <UsingTask TaskName="NativeSshComprobarSystemLinqEnIL" AssemblyFile="$(MSBuildProjectDirectory)/obj/nslinq/NativeSsh.ComprobarLinq.$([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)msbuild/ComprobarSystemLinqEnIL.cs').Ticks).$(MSBuildVersion).dll" />

  <!-- Exentos solo dos proyectos, y se decide únicamente con propiedades reservadas de MSBuild (nombre y ruta del proyecto
       y de este fichero), que ni un -p: ni un .csproj pueden cambiar: no hay ninguna propiedad que lo desactive.
       - native_ssh.Test, y solo el de este repositorio (native_ssh.Test/native_ssh.Test.csproj junto a este fichero).
       - BenchmarkDotNet.Autogenerated: el proyecto que BenchmarkDotNet genera para cada job (hereda este fichero; su
         código es de BenchmarkDotNet y usa System.Linq), y solo bajo native_ssh.Benchmarks/bin/ (lo deja en
         bin/<configuración>/<marco>/<proyecto>-<job>-<n>/; bin/ no se versiona).
       En Windows las rutas se comparan sin distinguir mayúsculas (su sistema de archivos tampoco), en los demás tal cual.
       Los no exentos llevan dos comprobaciones:
       - La definitiva, sobre el ensamblado compilado (NativeSshComprobarSystemLinqEnIL, más abajo): cualquier TypeRef de
         System.Linq o de un espacio bajo él (también anidados, genéricos instanciados, firmas, atributos y typeof en sus
         argumentos), se escribiera como se escribiera o lo generara el compilador ([.. hashSet] es Enumerable.ToArray; una
         lambda a Expression, System.Linq.Expressions); suprimir RS0030 no la afecta. El error dice el método (con fichero
         y línea si hay PDB) o el tipo que lo usa.
       - Aviso temprano en el editor: el analizador BannedApiAnalyzers con BannedSymbols.txt (N:System.Linq) y RS0030 como
         error (sinlinq.globalconfig). La tarea comprueba que esté referenciado.
       Fuera de alcance: desactivarlas a propósito con opciones de build (-p: o variables de entorno de MSBuild, un .rsp,
       redefinir los targets, quitar el paquete, un .editorconfig o .globalconfig) y la reflexión (un nombre de tipo en un
       string); se ve en la línea de órdenes o en el diff. -->
  <Choose>
    <When Condition="!(($([System.String]::Equals('$(MSBuildProjectName)', 'native_ssh.Test'))
            and (($([MSBuild]::IsOSPlatform('Windows')) and $([System.String]::Equals($([MSBuild]::NormalizePath('$(MSBuildProjectFullPath)').ToUpperInvariant()),
            $([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'native_ssh.Test', 'native_ssh.Test.csproj').ToUpperInvariant()))))
            or (!$([MSBuild]::IsOSPlatform('Windows')) and $([System.String]::Equals($([MSBuild]::NormalizePath('$(MSBuildProjectFullPath)')), $([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'native_ssh.Test', 'native_ssh.Test.csproj')))))))
          or ($([System.String]::Equals('$(MSBuildProjectName)', 'BenchmarkDotNet.Autogenerated'))
            and (($([MSBuild]::IsOSPlatform('Windows')) and $([System.String]::CompareOrdinal($([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').ToUpperInvariant()), 0, $([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'native_ssh.Benchmarks', 'bin').ToUpperInvariant()), 0, $([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'native_ssh.Benchmarks', 'bin').ToUpperInvariant().Length))) == 0)
            or (!$([MSBuild]::IsOSPlatform('Windows')) and $([System.String]::CompareOrdinal($([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)')), 0, $([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'native_ssh.Benchmarks', 'bin')), 0, $([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'native_ssh.Benchmarks', 'bin').Length))) == 0))))">
      <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)sinlinq.globalconfig" />
        <!-- Marca de proyecto no exento para el target de texto (un -p: no puede crear ni quitar elementos) -->
        <_NativeSshSinLinq Include="$(MSBuildProjectFullPath)" />
      </ItemGroup>
    </When>
  </Choose>

  <!-- Tras CoreCompile, también cuando no recompila (la tarea no tiene marca incremental: lee el ensamblado en cada build, unos
       milisegundos, así que un ensamblado que cambió o una marca con fecha futura no la saltan). Si falla, el build se para antes
       de copiar el ensamblado a bin. No corre en los builds de diseño del IDE ni cuando el compilador no escribe el ensamblado
       (SkipCompilerExecution, solo el de referencia). -->
  <Target Name="NativeSshCompilarTareaLinq" Inputs="$(MSBuildThisFileDirectory)msbuild/ComprobarSystemLinqEnIL.cs" Outputs="$(MSBuildProjectDirectory)/obj/nslinq/NativeSsh.ComprobarLinq.$([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)msbuild/ComprobarSystemLinqEnIL.cs').Ticks).$(MSBuildVersion).dll">
    <MakeDir Directories="$(MSBuildProjectDirectory)/obj/nslinq" />
    <Csc Sources="$(MSBuildThisFileDirectory)msbuild/ComprobarSystemLinqEnIL.cs"
         References="$(MSBuildToolsPath)/ref/mscorlib.dll;$(MSBuildToolsPath)/ref/netstandard.dll;$(MSBuildToolsPath)/ref/Microsoft.Build.Framework.dll;$(MSBuildToolsPath)/ref/Microsoft.Build.Utilities.Core.dll;$(MSBuildSDKsPath)/Microsoft.NET.Sdk/tools/net472/System.Reflection.Metadata.dll;$(MSBuildSDKsPath)/Microsoft.NET.Sdk/tools/net472/System.Collections.Immutable.dll"
         OutputAssembly="$(MSBuildProjectDirectory)/obj/nslinq/NativeSsh.ComprobarLinq.$([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)msbuild/ComprobarSystemLinqEnIL.cs').Ticks).$(MSBuildVersion).dll"
         TargetType="Library" NoStandardLib="true" NoConfig="true" Deterministic="true" Optimize="true" LangVersion="latest"
         TreatWarningsAsErrors="true" UseSharedCompilation="$(UseSharedCompilation)" />
  </Target>

  <Target Name="NativeSshProhibirSystemLinq" AfterTargets="CoreCompile" DependsOnTargets="NativeSshCompilarTareaLinq" Condition="'@(_NativeSshSinLinq)' != '' and '$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true' and '$(ProduceOnlyReferenceAssembly)' != 'true'">
    <NativeSshComprobarSystemLinqEnIL Ensamblado="@(IntermediateAssembly->'%(FullPath)')" Simbolos="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(TargetName).pdb'))" Analizadores="@(Analyzer)" />
  </Target>

</Project>
