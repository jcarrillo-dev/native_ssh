<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Sin IDE, el .editorconfig solo se cumple si el estilo se comprueba al compilar -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Necesario para que IDE0005 (usings sobrantes) se compruebe al compilar. Es un ejecutable, no un paquete: sin XML obligatorio -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Escáner de seguridad NuGet activado en modo estricto -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Sistema para el que se compila lo que depende del sistema (*.Linux.cs, *.Windows.cs, *.Unix.cs: la resolución de
       NATIVE_SSH_SOLO_LECTURA por familia): por el RID si lo hay (win-* windows, linux-* linux, los demás unix: osx, freebsd...)
       y si no, el del sistema donde se compila. Solo entra en el binario lo de su sistema. Se puede fijar con
       -p:NativeSshSistema=windows|linux|unix (p. ej. para compilar y probar en Linux lo de Windows). Define NATIVE_SSH_WINDOWS,
       NATIVE_SSH_LINUX o NATIVE_SSH_UNIX para las pruebas propias de cada sistema. Una variable de entorno NativeSshSistema
       (con cualquier combinación de mayúsculas: MSBuild convierte las variables de entorno en propiedades sin distinguirlas)
       no lo fija: solo vale una propiedad global (-p:NativeSshSistema), que no se puede pisar; para saber si lo es, se le da
       un valor de prueba: si lo toma, no era global y se descarta. -->
  <PropertyGroup>
    <NativeSshSistema>_sin_fijar_</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '_sin_fijar_'"></NativeSshSistema>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NativeSshSistema)' == ''">
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))">windows</NativeSshSistema>
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and '$(NativeSshSistema)' == '' and $(RuntimeIdentifier.StartsWith('linux-'))">linux</NativeSshSistema>
    <NativeSshSistema Condition="'$(RuntimeIdentifier)' != '' and '$(NativeSshSistema)' == ''">unix</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">windows</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</NativeSshSistema>
    <NativeSshSistema Condition="'$(NativeSshSistema)' == ''">unix</NativeSshSistema>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'windows'">$(DefineConstants);NATIVE_SSH_WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'linux'">$(DefineConstants);NATIVE_SSH_LINUX</DefineConstants>
    <DefineConstants Condition="'$(NativeSshSistema)' == 'unix'">$(DefineConstants);NATIVE_SSH_UNIX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Linq" />
  </ItemGroup>

  <Target Name="EliminarSystemLinqGlobal" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Linq" />
    </ItemGroup>
  </Target>

  <!-- Solo las pruebas pueden usar System.Linq (exentos y comprobación semántica, más abajo). Búsqueda por texto en cada
       fuente a compilar (también los generados, como el de los global using), sin contar lo que va tras '//' en la línea:
       System.Linq en un using (normal, global, static o alias) o con el nombre completo, el identificador RS0030 y un
       '#pragma warning disable' sin identificadores. Tarea
       en línea de MSBuild (sin paquetes ni órdenes del shell): igual en Linux y en Windows. El SSH.NET del submódulo tiene
       su propio Directory.Build.props y no pasa por aquí. -->
  <UsingTask TaskName="NativeSshBuscarSystemLinq" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Fuentes ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Analizadores ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        bool hasAnalizador = false;
        foreach (ITaskItem analizador in Analizadores ?? new ITaskItem[0])
            if (string.Equals(analizador.GetMetadata("Filename"), "Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers", StringComparison.OrdinalIgnoreCase))
                hasAnalizador = true;
        if (!hasAnalizador)
            Log.LogError(null, "NSLINQ", null, null, 0, 0, 0, 0, "Falta el analizador Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers, que prohíbe System.Linq (RS0030).");
        // Además de System.Linq, lo que suprimiría RS0030 en el fuente: el identificador (#pragma, SuppressMessage) y un
        // '#pragma warning disable' sin identificadores.
        Regex patron = new Regex(@"\busing\s+(global::)?System\.Linq\b|\busing\s+static\s+(global::)?System\.Linq\.|\busing\s+\w+\s*=\s*(global::)?System\.Linq\b|(global::|[^\w.])System\.Linq\.|\bRS0030\b|#\s*pragma\s+warning\s+disable\s*$", RegexOptions.CultureInvariant);
        foreach (ITaskItem fuente in Fuentes)
        {
            string ruta = fuente.GetMetadata("FullPath");
            if (!File.Exists(ruta))
                continue;
            int numero = 0;
            foreach (string linea in File.ReadLines(ruta))
            {
                numero++;
                int comentario = linea.IndexOf("//", StringComparison.Ordinal);
                string codigo = comentario >= 0 ? linea.Substring(0, comentario) : linea;
                Match coincidencia = patron.Match(" " + codigo);
                if (coincidencia.Success)
                    Log.LogError(null, "NSLINQ", null, ruta, numero, coincidencia.Index, 0, 0, "System.Linq solo se puede usar en las pruebas (native_ssh.Test), y su prohibición (RS0030) no se suprime: '{0}'.", linea.Trim());
            }
        }
        Success = !Log.HasLoggedErrors;
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Exentos solo dos proyectos, y se decide únicamente con propiedades reservadas de MSBuild (nombre y ruta del proyecto
       y de este fichero), que ni un -p: ni un .csproj pueden cambiar: no hay ninguna propiedad que lo desactive.
       - native_ssh.Test, y solo el de este repositorio (native_ssh.Test/native_ssh.Test.csproj junto a este fichero).
       - BenchmarkDotNet.Autogenerated: el proyecto que BenchmarkDotNet genera para cada job (hereda este fichero; su
         código es de BenchmarkDotNet y usa System.Linq), y solo bajo native_ssh.Benchmarks/bin/ (lo deja en
         bin/<configuración>/<marco>/<proyecto>-<job>-<n>/; bin/ no se versiona).
       En Windows las rutas se comparan sin distinguir mayúsculas (su sistema de archivos tampoco), en los demás tal cual.
       Los no exentos llevan dos comprobaciones:
       - Semántica: el analizador BannedApiAnalyzers con BannedSymbols.txt (N:System.Linq) y RS0030 como error
         (sinlinq.globalconfig). Ve cualquier uso de un miembro de System.Linq, se escriba como se escriba: comentarios
         dentro del nombre, partido en líneas, alias por partes, 'namespace System { using Linq; }', un espacio de nombres
         bajo System.Linq, métodos de extensión. No ve un tipo de System.Linq que solo aparece en una firma ni la reflexión.
       - Por texto, como red de seguridad (NativeSshBuscarSystemLinq, en cada build, sin marca incremental): los usings y el
         nombre completo aunque no se usen, lo que suprimiría RS0030 en el fuente (su identificador o un '#pragma warning
         disable' sin identificadores) y que el analizador esté referenciado.
       Desactivarlas a propósito con opciones de build (-p: o variables de entorno de MSBuild, un .rsp, redefinir los
       targets o quitar el paquete en un .csproj o en otro fichero de MSBuild) queda fuera: se ve en la línea de órdenes o
       en el diff. -->
  <Choose>
    <When Condition="!(($([System.String]::Equals('$(MSBuildProjectName)', 'native_ssh.Test'))
            and (($([MSBuild]::IsOSPlatform('Windows')) and $([System.String]::Equals($([MSBuild]::NormalizePath('$(MSBuildProjectFullPath)').ToUpperInvariant()),
            $([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'native_ssh.Test', 'native_ssh.Test.csproj').ToUpperInvariant()))))
            or (!$([MSBuild]::IsOSPlatform('Windows')) and $([System.String]::Equals($([MSBuild]::NormalizePath('$(MSBuildProjectFullPath)')), $([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'native_ssh.Test', 'native_ssh.Test.csproj')))))))
          or ($([System.String]::Equals('$(MSBuildProjectName)', 'BenchmarkDotNet.Autogenerated'))
            and (($([MSBuild]::IsOSPlatform('Windows')) and $([System.String]::CompareOrdinal($([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').ToUpperInvariant()), 0, $([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'native_ssh.Benchmarks', 'bin').ToUpperInvariant()), 0, $([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'native_ssh.Benchmarks', 'bin').ToUpperInvariant().Length))) == 0)
            or (!$([MSBuild]::IsOSPlatform('Windows')) and $([System.String]::CompareOrdinal($([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)')), 0, $([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'native_ssh.Benchmarks', 'bin')), 0, $([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'native_ssh.Benchmarks', 'bin').Length))) == 0))))">
      <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)sinlinq.globalconfig" />
        <!-- Marca de proyecto no exento para el target de texto (un -p: no puede crear ni quitar elementos) -->
        <_NativeSshSinLinq Include="$(MSBuildProjectFullPath)" />
      </ItemGroup>
    </When>
  </Choose>

  <Target Name="NativeSshProhibirSystemLinq" BeforeTargets="CoreCompile" Condition="'@(_NativeSshSinLinq)' != ''">
    <NativeSshBuscarSystemLinq Fuentes="@(Compile)" Analizadores="@(Analyzer)" />
  </Target>

</Project>
