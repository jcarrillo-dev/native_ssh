<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NativeSsh</RootNamespace>
    <!-- CA1707: sin guion bajo en el nombre del ensamblado. El ejecutable publicado se llama NativeSsh -->
    <AssemblyName>NativeSsh</AssemblyName>

    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- LibraryImport (InteropLinux: open sin seguir enlaces y statx del fichero del token HTTP) genera código unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IlLinkTreatWarningsAsErrors>true</IlLinkTreatWarningsAsErrors>

    <OptimizationPreference>Speed</OptimizationPreference>
    <OverflowChecks>false</OverflowChecks>
    <TieredCompilation>false</TieredCompilation>

    <!-- El SDK Web solo se usa por Kestrel: sin activos estáticos ni XML junto al ejecutable -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JCarrillo.AOT.Core" Version="1.1.4" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSH.NET desde su código fuente (submódulo en externo/SSH.NET, rama native-ssh sobre la etiqueta 2026.0.0) para poder corregir sus fallos en origen -->
    <ProjectReference Include="..\externo\SSH.NET\src\Renci.SshNet\Renci.SshNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lo de cada sistema solo para su sistema (NativeSshSistema, en Directory.Build.props) -->
    <Compile Remove="**/*.Linux.cs" Condition="'$(NativeSshSistema)' != 'linux'" />
    <Compile Remove="**/*.Windows.cs" Condition="'$(NativeSshSistema)' != 'windows'" />
    <Compile Remove="**/*.Unix.cs" Condition="'$(NativeSshSistema)' != 'unix'" />
  </ItemGroup>

</Project>
